 t.check(ui.find_child("EncyclopediaEntry_henshin",true,false)!=null and hidden_variants.all(func(id):return ui.find_child("EncyclopediaEntry_"+id,true,false)==null),"BOOK UI special name search finds its original without a duplicate row")
 variant_search.text="";variant_search.text_changed.emit("");await t.frames()
 var family_book=ui.find_child("Encyclopedia",true,false)
 for term in ["般若汤","般若汤-其二","般若汤-其三","般若汤-其四","好汤喝够"]:
  variant_search.text=term;variant_search.text_changed.emit(term);await t.frames()
  var soup_rows=ui.find_child("EncyclopediaEntries",true,false).get_children()
