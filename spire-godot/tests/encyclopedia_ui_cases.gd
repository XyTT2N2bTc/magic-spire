 var item_detail=t.visible_text(ui.find_child("EncyclopediaDetail",true,false))
 t.check(ui.find_child("EncyclopediaEntries",true,false).get_child_count()==1 and item_detail.contains("7点真实伤害") and item_detail.contains("使用次数：2") and item_detail.contains("安装后") and ui.find_child("EncyclopediaItemIcon",true,false).symbol=="saw","BOOK searchable tool detail shows damage, uses and shared installation effect")
 t.check(ui.game.export_snapshot()==initial and not store.has_files("tower"),"BOOK item browsing neither starts a run nor changes gameplay")
 await t.capture("ui-encyclopedia-items.png")
 item_search.text="";item_search.text_changed.emit("");await t.frames()
 await Click.press(t,"EncyclopediaCategory_special")
 var image_search=ui.find_child("EncyclopediaSearch",true,false)
 image_search.text=ui.game.SpecialEquipment.TYPES.urethral_rod_medium.name;image_search.text_changed.emit(image_search.text);await t.frames()
 await Click.press(t,"EncyclopediaEntry_urethral_rod_medium")
 equipment_picture=ui.find_child("EncyclopediaEquipmentImage",true,false)
 t.check(equipment_picture!=null and equipment_picture.texture.resource_path.ends_with("focus-c-silicone-urethral-rod.png"),"BOOK selecting illustrated special equipment shows the existing local picture")
 image_search.text="";image_search.text_changed.emit("");await t.frames()
 await Click.press(t,"EncyclopediaEntry_nipple_clamp_low")
 t.check(ui.find_child("EncyclopediaEquipmentImage",true,false)==null and ui.game.export_snapshot()==initial,"BOOK missing-image selection clears previous picture without changing gameplay")
 for category in ["equipment","special","enemies","cards"]:
  await Click.press(t,"EncyclopediaCategory_"+category)
  t.check(ui.find_child("EncyclopediaEntries",true,false).get_child_count()>0,"BOOK populated category "+category)
