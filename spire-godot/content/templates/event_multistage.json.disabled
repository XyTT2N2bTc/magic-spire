{
  "schema_version": 1,
  "kind": "event",
  "id": "example_multistage_challenge",
  "name": "多阶段挑战示例",
  "intro": "这是多阶段事件的数据模板；改名为 .json 并放入 content/packs 后才会加载。",
  "start_stage": "entry",
  "cleanup_effects": [
    {"op": "restore_held", "key": "removed_gear"}
  ],
  "stages": [
    {
      "id": "entry",
      "title": "是否参加",
      "intro": "第一阶段必须允许使用默认付费离开。",
      "allow_refuse": true,
      "choices": [
        {
          "id": "accept",
          "label": "参加挑战",
          "reward": "none",
          "next": "penalty",
          "detail": "暂时取下肉棒部位已有的性玩具，并从两种公开结果中随机确定一种。",
          "effects": [
            {"op": "hold_special", "key": "removed_gear", "slots": ["special_2_a", "special_2_b", "special_2_c", "special_2_d"]}
          ],
          "outcomes": [
            {"weight": 1, "effects": [{"op": "card", "type": "panic"}], "report": "获得了诅咒牌「慌乱」"},
            {"weight": 1, "effects": [{"op": "card", "type": "sensitive"}], "report": "获得了诅咒牌「敏感」"}
          ]
        }
      ]
    },
    {
      "id": "penalty",
      "title": "选择代价",
      "intro": "生成器会在进入本阶段时冻结为具体、可预览的正式效果。",
      "allow_refuse": false,
      "choices": [
        {
          "id": "add_rope",
          "label": "随机安装两件初级绳索",
          "reward": "none",
          "next": "finish",
          "effects": [
            {"op": "install_random", "templates": ["rope"], "count": 2, "grade": 1, "tier": 2, "locked": false}
          ]
        },
        {
          "id": "tighten_two",
          "label": "随机收紧两件现有拘束具",
          "reward": "none",
          "next": "finish",
          "effects": [
            {"op": "tighten_random", "count": 2, "to_tier": 3}
          ]
        }
      ]
    },
    {
      "id": "finish",
      "title": "结束",
      "intro": "最后阶段仍使用普通效果白名单。",
      "allow_refuse": false,
      "choices": [
        {"id": "complete", "label": "完成事件", "reward": "none", "next": "result", "effects": [{"op": "pressure", "amount": 20, "source": "事件中的刺激"}]}
      ]
    }
  ]
}
